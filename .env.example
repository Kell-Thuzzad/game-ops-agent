# Moonshot（Kimi）API Key；留空时自动使用本地规则基线模式
MOONSHOT_API_KEY=

# 使用其他 OpenAI 兼容网关时，可改用 OPENAI_API_KEY 并覆盖 LLM_BASE_URL
# OPENAI_API_KEY=
LLM_BASE_URL=https://api.moonshot.cn/v1
LLM_MODEL=kimi-k2.5

LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=120

# 最多加载多少条评论
MAX_COMMENTS=20000
# --full-context 模式下的评论原文预算（字符）
MAX_CONTEXT_CHARS=120000
